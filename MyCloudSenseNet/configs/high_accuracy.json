{
  "_description": "高精度训练配置 - 用于生产模型，追求最高精度",
  "model_name": "unet",
  "backbone": "timm-efficientnet-b4",
  "encoder_weights": "imagenet",
  "in_channels": 4,
  "num_classes": 3,
  "learning_rate": 0.00005,
  "batch_size": 2,
  "max_epochs": 150,
  "bit_depth": {
    "enabled": true,
    "estimator_type": "statistical",
    "adapter_type": "original",
    "min_bit_depth": 8,
    "max_bit_depth": 12,
    "enable_multiscale_fusion": true,
    "fusion_type": "attention",
    "enable_spatial_spectral_attention": true,
    "ssa_reduction": 4
  },
  "loss": {
    "ce_weight": 1.0,
    "dice_weight": 1.0,
    "focal_weight": 1.0,
    "enable_dynamic_weighting": true,
    "enable_focal_loss": true,
    "focal_alpha": 0.25,
    "focal_gamma": 2.0,
    "enable_boundary_loss": true,
    "boundary_width": 7,
    "boundary_weight": 3.0,
    "enable_class_adaptive_weights": true
  },
  "training": {
    "lr_scheduler_type": "cosine_warmup",
    "warmup_epochs": 10,
    "cosine_t_0": 20,
    "cosine_t_mult": 2,
    "eta_min": 1e-07,
    "optimizer_type": "adamw",
    "weight_decay": 0.0001,
    "encoder_lr_scale": 0.3,
    "bit_depth_component_lr_scale": 2.0,
    "enable_deep_supervision": true,
    "deep_supervision_weights": [0.5, 0.3, 0.2, 0.1]
  },
  "inference": {
    "enable_adaptive_tta": true,
    "tta_confidence_threshold": 0.95,
    "tta_light_modes": ["none", "rot180", "hflip"],
    "tta_full_modes": [
      "none",
      "rot90",
      "rot180",
      "rot270",
      "hflip",
      "vflip",
      "diag",
      "anti_diag"
    ],
    "enable_quantization": false,
    "quantization_backend": "fbgemm",
    "enable_pruning": false,
    "pruning_amount": 0.3,
    "enable_onnx_export": true,
    "onnx_opset": 12
  },
  "data": {
    "enable_disk_cache": true,
    "cache_dir": null,
    "max_memory_cache": 200,
    "num_workers": 4,
    "prefetch_factor": 4,
    "persistent_workers": true,
    "pin_memory": true
  }
}
